# Backend Environment Variables (Configured in Netlify Dashboard for production)
PORT=5000
NODE_ENV=production

# AI Provider Keys (At least one is required if not providing keys on the client)
GEMINI_API_KEY=
GROQ_API_KEY=

# Allowed CORS Origins (optional, defaults to same-origin / all in development)
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
